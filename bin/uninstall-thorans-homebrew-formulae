#!/usr/bin/env ruby
# uninstall-thorans-homebrew-formulae

# 20261028
# 0.1.1

# Description: Remove the gh aliases of the gh- formulae in thoran/tap, then uninstall all its formulae.

require 'json'

def tap_directory
  @tap_directory ||= `brew --repo thoran/tap`.chomp
end

def uninstall_gh_aliases
  system(RbConfig.ruby, File.join(tap_directory, 'bin', 'uninstall-thorans-gh-aliases'))
end

def formulae
  @formulae ||= JSON.parse(`brew tap-info thoran/homebrew-tap --json`)[0]['formula_names']
end

def installed_formulae
  @installed_formulae ||= `brew list --full-name --formula`.split("\n")
end

def installed?(formula)
  installed_formulae.include?(formula)
end

def uninstall(formula)
  puts '', "brew uninstall #{formula}", ''
  system("brew uninstall #{formula}")
end

def main
  uninstall_gh_aliases
  puts
  formulae.each do |formula|
    if installed?(formula)
      uninstall(formula)
    else
      puts "#{formula} is not installed; skipping."
    end
  end
end

main

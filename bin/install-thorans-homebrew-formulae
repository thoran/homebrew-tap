#!/usr/bin/env ruby
# install-thorans-homebrew-formulae

# 20261028
# 0.1.1

# Description: Install all formulae in thoran/tap, then alias the gh- ones.

require 'json'

def formulae
  JSON.parse(`brew tap-info thoran/homebrew-tap --json`)[0]['formula_names']
end

def tap_directory
  @tap_directory ||= `brew --repo thoran/tap`.chomp
end

def install_gh_aliases
  system(RbConfig.ruby, File.join(tap_directory, 'bin', 'install-thorans-gh-aliases'))
end

def main
  system('brew tap thoran/tap')
  system('brew update')
  formulae.each do |formula|
    puts '', "brew install #{formula}", ''
    system("brew install #{formula}")
  end
  puts
  install_gh_aliases
end

main
